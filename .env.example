# ============================================================
# Voice Agent OS - Environment Configuration
# Copy this file to .env and fill in your keys.
# ============================================================

# ---- NVIDIA (required for real AI; mock fallback works without) ----
# Get a key: https://org.ngc.nvidia.com/setup/api-key
NVIDIA_API_KEY=

# ---- Provider selection -------------------------------------------------
# llm:   mock | nvidia            (nvidia = NVIDIA NIM/AI Endpoints)
# asr:   mock | nvidia            (nvidia = NVIDIA Riva cloud ASR)
# tts:   mock | nvidia            (nvidia = NVIDIA Riva cloud TTS)
# audio: mock | mic               (mic = real microphone/playback)
# telephony: mock | twilio        (twilio = real phone calls)
PROVIDER_LLM=mock
PROVIDER_ASR=mock
PROVIDER_TTS=mock
PROVIDER_AUDIO=mock
PROVIDER_TELEPHONY=mock

# ---- NVIDIA endpoint models ----------------------------------------------
# LLM served by NVIDIA NIM / AI Endpoints (OpenAI compatible)
NVIDIA_LLM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_LLM_MODEL=meta/llama-3.3-70b-instruct

# Riva cloud speech endpoints
NVIDIA_RIVA_URL=https://riva.api.nvidia.com
NVIDIA_ASR_LANGUAGE=en-US
NVIDIA_TTS_VOICE=English-US.Male

# ---- Voice assistant -----------------------------------------------------
ASSISTANT_NAME=Nova
ASSISTANT_WAKE_WORD=nova
ASSISTANT_AUTO_GRANT=true

# ---- Telephony (Twilio) ---------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Server ----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
API_ADMIN_KEY=change-me-admin-key
